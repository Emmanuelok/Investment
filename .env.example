# ─────────────────────────────────────────────────────────────────────────────
# PANTHEON — environment configuration (12-factor; nothing hard-coded)
# Copy to `.env.local` for local dev. The UI runs fully without any keys
# (demo data fabric). Keys below light up live backends as drop-in upgrades.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI copilot (ATHENA) — Anthropic Claude ───────────────────────────────────
ANTHROPIC_API_KEY=
ATHENA_MODEL=claude-opus-4-8

# ── OBSIDIAN data fabric — free sources (optional keys raise rate limits) ─────
FRED_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
SEC_EDGAR_USER_AGENT="Pantheon Research contact@example.com"

# ── Licensed market-data upgrades (optional drop-ins) ─────────────────────────
DATABENTO_API_KEY=
POLYGON_API_KEY=

# ── HELIOS real-time order flow — free crypto WS needs no key ─────────────────
# (Binance / Coinbase / Bybit public websockets via CCXT Pro)

# ── AEGIS execution venues (optional; sim runs with zero accounts) ────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
IBKR_GATEWAY_HOST=
IBKR_GATEWAY_PORT=

# ── Alt-data signal vendors (ARGUS) — optional ───────────────────────────────
QUIVER_API_KEY=
THINKNUM_API_KEY=

# ── Public site URL (used for absolute links / OG) ────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
